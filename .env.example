# copy this file to .env for local testing (netlify dev reads it)
# on netlify, add the same names under site configuration > environment variables
# never paste these keys into anything inside the site folder

# stripe dashboard > developers > api keys. use the test key while building, the client's live key at launch
STRIPE_SECRET_KEY=sk_test_...

# from `stripe listen` locally, or the webhook endpoint in the stripe dashboard once deployed
STRIPE_WEBHOOK_SECRET=whsec_...

# optional. netlify sets the site address on its own when deployed, so this is only for local testing
SITE_URL=http://localhost:8888
